## The voice of one kind of NPC (a regular customer, a grandma in the street,
## a police officer): every line they can say, grouped by category. NPCs
## speak through an NpcVoice component that picks from these.
##
##   var lines: Array[VoiceLineData] = voice.get_lines(VoiceLineData.GREET)
##
## The .tres files in Ressources/Voices/ and the recordings in
## Assets/Audio/Voices/ are generated by Tools/generate_voices.ps1.
##
## Dependencies: VoiceLineData
class_name VoiceData
extends Resource

@export var id: StringName = &""
@export var display_name: String = ""
## Loudness offset (dB) so quiet and loud voices sit at the same level.
@export var volume_db: float = 0.0
@export var lines: Array[VoiceLineData] = []

var _lines_by_category: Dictionary = {}


## Every line of [param category] (empty when this voice has none).
func get_lines(category: StringName) -> Array[VoiceLineData]:
	if _lines_by_category.is_empty():
		_index_lines()
	var found: Array[VoiceLineData] = []
	found.assign(_lines_by_category.get(category, []))
	return found


func has_lines(category: StringName) -> bool:
	return not get_lines(category).is_empty()


func _index_lines() -> void:
	for line: VoiceLineData in lines:
		if line == null:
			continue
		if not _lines_by_category.has(line.category):
			_lines_by_category[line.category] = []
		(_lines_by_category[line.category] as Array).append(line)
