[node name="Idle" type="Node" parent="StateChart/Root"]
script = ExtResource("atomic")

[node name="ToMoving" type="Node" parent="StateChart/Root/Idle"]
script = ExtResource("transition")
to = NodePath("../../Moving")
event = &"picker_target"
delay_in_seconds = "0.0"

[node name="Moving" type="Node" parent="StateChart/Root"]
script = ExtResource("atomic")

[node name="ToPicking" type="Node" parent="StateChart/Root/Moving"]
script = ExtResource("transition")
to = NodePath("../../Picking")
event = &"picker_arrived"
delay_in_seconds = "0.0"

[node name="GiveUp" type="Node" parent="StateChart/Root/Moving"]
script = ExtResource("transition")
to = NodePath("../../Idle")
event = &"picker_done"
delay_in_seconds = "0.0"

[node name="Picking" type="Node" parent="StateChart/Root"]
script = ExtResource("atomic")

[node name="ToIdle" type="Node" parent="StateChart/Root/Picking"]
script = ExtResource("transition")
to = NodePath("../../Idle")
event = &"picker_done"
