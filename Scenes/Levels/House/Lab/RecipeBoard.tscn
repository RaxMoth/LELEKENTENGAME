[gd_scene format=3]

[ext_resource type="Script" path="res://Scenes/Levels/House/Lab/recipe_board.gd" id="board"]
[ext_resource type="Script" path="res://Scripts/UI/icon_label.gd" id="icon_label"]
[ext_resource type="Texture2D" path="res://Assets/Icons/sparkle.svg" id="sparkle"]

[node name="RecipeBoard" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("board")

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"CardPanel"

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 24

[node name="Column" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Header" type="HBoxContainer" parent="Panel/Margin/Column"]
layout_mode = 2

[node name="Title" type="Label" parent="Panel/Margin/Column/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"HeaderLabel"
text = "Recipe book"

[node name="UnlockedLabel" type="HBoxContainer" parent="Panel/Margin/Column/Header"]
unique_name_in_owner = true
layout_mode = 2
script = ExtResource("icon_label")
icon = ExtResource("sparkle")
text = "0 / 0 unlocked"
icon_size = 40
icon_color = Color(0.9686, 0.7725, 0.2824, 1)

[node name="Rows" type="VBoxContainer" parent="Panel/Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 16

[node name="Hint" type="Label" parent="Panel/Margin/Column"]
layout_mode = 2
theme_type_variation = &"SmallLabel"
text = "Unlock gadgets and recipes in the office."
horizontal_alignment = 1
