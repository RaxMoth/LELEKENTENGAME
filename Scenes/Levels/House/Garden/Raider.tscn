[gd_scene format=3]

[ext_resource type="Script" path="res://Scenes/Levels/House/Garden/raider.gd" id="raider"]
[ext_resource type="Script" path="res://Scenes/Levels/House/Garden/raider_body.gd" id="body"]
[ext_resource type="Script" path="res://Scripts/Components/npc_voice.gd" id="voice_component"]
[ext_resource type="Resource" path="res://Ressources/Voices/polizist.tres" id="police_voice"]
[ext_resource type="Script" path="res://Scripts/Utils/blob_shadow_3d.gd" id="shadow"]
[ext_resource type="Script" path="res://Scripts/Components/health_component.gd" id="health"]
[ext_resource type="Script" path="res://Scripts/Components/hit_flash_3d_component.gd" id="flash"]
[ext_resource type="Script" path="res://addons/godot_state_charts/state_chart.gd" id="chart"]
[ext_resource type="Script" path="res://addons/godot_state_charts/compound_state.gd" id="compound"]
[ext_resource type="Script" path="res://addons/godot_state_charts/atomic_state.gd" id="atomic"]
[ext_resource type="Script" path="res://addons/godot_state_charts/transition.gd" id="transition"]

[node name="Raider" type="Node3D"]
script = ExtResource("raider")
hit_radius = 0.42
hit_height = 1.2

[node name="Visual" type="Node3D" parent="."]
unique_name_in_owner = true

[node name="RaiderBody" type="Node3D" parent="Visual"]
script = ExtResource("body")

[node name="Voice" type="Node3D" parent="."]
unique_name_in_owner = true
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.75, 0)
script = ExtResource("voice_component")
voice = ExtResource("police_voice")
chatter_cooldown_seconds = 6.0

[node name="Shadow" type="MeshInstance3D" parent="."]
script = ExtResource("shadow")
diameter = 0.85

[node name="HealthComponent" type="Node" parent="."]
unique_name_in_owner = true
script = ExtResource("health")
max_health = 120.0

[node name="HitFlash3DComponent" type="Node" parent="." node_paths=PackedStringArray("flash_root", "health_component")]
unique_name_in_owner = true
script = ExtResource("flash")
flash_root = NodePath("../Visual")
health_component = NodePath("../HealthComponent")

[node name="StateChart" type="Node" parent="."]
unique_name_in_owner = true
script = ExtResource("chart")

[node name="Root" type="Node" parent="StateChart"]
script = ExtResource("compound")
initial_state = NodePath("Alive")

[node name="Alive" type="Node" parent="StateChart/Root"]
script = ExtResource("compound")
initial_state = NodePath("Moving")

[node name="Moving" type="Node" parent="StateChart/Root/Alive"]
script = ExtResource("atomic")

[node name="ToInCover" type="Node" parent="StateChart/Root/Alive/Moving"]
script = ExtResource("transition")
to = NodePath("../../InCover")
event = &"take_cover"
delay_in_seconds = "0.0"

[node name="ToAttacking" type="Node" parent="StateChart/Root/Alive/Moving"]
script = ExtResource("transition")
to = NodePath("../../Attacking")
event = &"target_in_range"
delay_in_seconds = "0.0"

[node name="InCover" type="Node" parent="StateChart/Root/Alive"]
script = ExtResource("atomic")

[node name="ToMoving" type="Node" parent="StateChart/Root/Alive/InCover"]
script = ExtResource("transition")
to = NodePath("../../Moving")
event = &"move"
delay_in_seconds = "0.0"

[node name="Attacking" type="Node" parent="StateChart/Root/Alive"]
script = ExtResource("atomic")

[node name="Hunting" type="Node" parent="StateChart/Root/Alive"]
script = ExtResource("atomic")

[node name="ToMoving" type="Node" parent="StateChart/Root/Alive/Hunting"]
script = ExtResource("transition")
to = NodePath("../../Moving")
event = &"move"
delay_in_seconds = "0.0"

[node name="ToHunting" type="Node" parent="StateChart/Root/Alive"]
script = ExtResource("transition")
to = NodePath("../Hunting")
event = &"hunt"
delay_in_seconds = "0.0"

[node name="ToDead" type="Node" parent="StateChart/Root/Alive"]
script = ExtResource("transition")
to = NodePath("../../Dead")
event = &"died"
delay_in_seconds = "0.0"

[node name="Dead" type="Node" parent="StateChart/Root"]
script = ExtResource("atomic")

[node name="ToAlive" type="Node" parent="StateChart/Root/Dead"]
script = ExtResource("transition")
to = NodePath("../../Alive")
event = &"respawn"
delay_in_seconds = "0.0"

[connection signal="state_entered" from="StateChart/Root/Alive/Moving" to="." method="_on_moving_state_entered"]
[connection signal="state_physics_processing" from="StateChart/Root/Alive/Moving" to="." method="_on_moving_state_physics_processing"]
[connection signal="state_entered" from="StateChart/Root/Alive/InCover" to="." method="_on_in_cover_state_entered"]
[connection signal="state_physics_processing" from="StateChart/Root/Alive/InCover" to="." method="_on_in_cover_state_physics_processing"]
[connection signal="state_entered" from="StateChart/Root/Alive/Attacking" to="." method="_on_attacking_state_entered"]
[connection signal="state_physics_processing" from="StateChart/Root/Alive/Attacking" to="." method="_on_attacking_state_physics_processing"]
[connection signal="state_entered" from="StateChart/Root/Alive/Hunting" to="." method="_on_hunting_state_entered"]
[connection signal="state_physics_processing" from="StateChart/Root/Alive/Hunting" to="." method="_on_hunting_state_physics_processing"]
[connection signal="state_entered" from="StateChart/Root/Dead" to="." method="_on_dead_state_entered"]
