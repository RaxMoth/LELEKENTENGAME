[gd_scene format=3]

[ext_resource type="Script" path="res://Scenes/Levels/House/Ghost/ghost.gd" id="ghost"]
[ext_resource type="Script" path="res://addons/godot_state_charts/state_chart.gd" id="chart"]
[ext_resource type="Script" path="res://addons/godot_state_charts/compound_state.gd" id="compound"]
[ext_resource type="Script" path="res://addons/godot_state_charts/atomic_state.gd" id="atomic"]
[ext_resource type="Script" path="res://addons/godot_state_charts/transition.gd" id="transition"]

[sub_resource type="StandardMaterial3D" id="body_material"]
resource_local_to_scene = true
resource_name = "GhostBody"
transparency = 1
shading_mode = 0
albedo_color = Color(0.84, 0.88, 0.96, 0.42)

[sub_resource type="StandardMaterial3D" id="eye_material"]
resource_local_to_scene = true
resource_name = "GhostEyes"
transparency = 1
shading_mode = 0
albedo_color = Color(0.02, 0.03, 0.05, 0.92)

[sub_resource type="CylinderMesh" id="shroud_mesh"]
top_radius = 0.12
bottom_radius = 0.3
height = 1.5
radial_segments = 18
rings = 1

[sub_resource type="SphereMesh" id="head_mesh"]
radius = 0.19
height = 0.4
radial_segments = 18
rings = 9

[sub_resource type="SphereMesh" id="eye_mesh"]
radius = 0.032
height = 0.05
radial_segments = 8
rings = 4

[sub_resource type="SphereMesh" id="hood_mesh"]
radius = 0.22
height = 0.5
radial_segments = 18
rings = 9

[node name="Ghost" type="Node3D"]
visible = false
script = ExtResource("ghost")
fading_materials = Array[StandardMaterial3D]([SubResource("body_material"), SubResource("eye_material")])

[node name="Figure" type="Node3D" parent="."]
unique_name_in_owner = true
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.12, 0)

[node name="Shroud" type="MeshInstance3D" parent="Figure"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.75, 0)
cast_shadow = 0
mesh = SubResource("shroud_mesh")
material_override = SubResource("body_material")

[node name="Head" type="MeshInstance3D" parent="Figure"]
unique_name_in_owner = true
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.62, 0)
cast_shadow = 0
mesh = SubResource("head_mesh")
material_override = SubResource("body_material")

[node name="EyeLeft" type="MeshInstance3D" parent="Figure"]
transform = Transform3D(1, 0, 0, 0, 1.5, 0, 0, 0, 1, -0.066, 1.64, -0.165)
cast_shadow = 0
mesh = SubResource("eye_mesh")
material_override = SubResource("eye_material")

[node name="EyeRight" type="MeshInstance3D" parent="Figure"]
transform = Transform3D(1, 0, 0, 0, 1.5, 0, 0, 0, 1, 0.066, 1.64, -0.165)
cast_shadow = 0
mesh = SubResource("eye_mesh")
material_override = SubResource("eye_material")

[node name="Hood" type="MeshInstance3D" parent="Figure"]
transform = Transform3D(1, 0, 0, 0, 1.15, 0, 0, 0, 1, 0, 1.66, 0.05)
cast_shadow = 0
mesh = SubResource("hood_mesh")
material_override = SubResource("body_material")

[node name="StateChart" type="Node" parent="."]
unique_name_in_owner = true
script = ExtResource("chart")

[node name="Root" type="Node" parent="StateChart"]
script = ExtResource("compound")
initial_state = NodePath("Waiting")

[node name="Waiting" type="Node" parent="StateChart/Root"]
script = ExtResource("atomic")

[node name="ToLurking" type="Node" parent="StateChart/Root/Waiting"]
script = ExtResource("transition")
to = NodePath("../../Lurking")
event = &"ghost_appear"
delay_in_seconds = "0.0"

[node name="Lurking" type="Node" parent="StateChart/Root"]
script = ExtResource("atomic")

[node name="ToSeen" type="Node" parent="StateChart/Root/Lurking"]
script = ExtResource("transition")
to = NodePath("../../Seen")
event = &"ghost_seen"
delay_in_seconds = "0.0"

[node name="ToGone" type="Node" parent="StateChart/Root/Lurking"]
script = ExtResource("transition")
to = NodePath("../../Gone")
event = &"ghost_gone"
delay_in_seconds = "0.0"

[node name="Seen" type="Node" parent="StateChart/Root"]
script = ExtResource("atomic")

[node name="ToGone" type="Node" parent="StateChart/Root/Seen"]
script = ExtResource("transition")
to = NodePath("../../Gone")
event = &"ghost_gone"
delay_in_seconds = "0.0"

[node name="Gone" type="Node" parent="StateChart/Root"]
script = ExtResource("atomic")

[connection signal="state_entered" from="StateChart/Root/Waiting" to="." method="_on_waiting_state_entered"]
[connection signal="state_entered" from="StateChart/Root/Lurking" to="." method="_on_lurking_state_entered"]
[connection signal="state_processing" from="StateChart/Root/Lurking" to="." method="_on_lurking_state_processing"]
[connection signal="state_entered" from="StateChart/Root/Seen" to="." method="_on_seen_state_entered"]
[connection signal="state_processing" from="StateChart/Root/Seen" to="." method="_on_seen_state_processing"]
[connection signal="state_entered" from="StateChart/Root/Gone" to="." method="_on_gone_state_entered"]
