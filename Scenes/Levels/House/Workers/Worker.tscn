[node name="Root" type="Node" parent="StateChart"]
script = ExtResource("compound")
initial_state = NodePath("Absent")

[node name="Absent" type="Node" parent="StateChart/Root"]
script = ExtResource("atomic")

[node name="ToWorking" type="Node" parent="StateChart/Root/Absent"]
