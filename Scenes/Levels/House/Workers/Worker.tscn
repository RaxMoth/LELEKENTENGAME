event = &"hired"
delay_in_seconds = "0.0"

[node name="Working" type="Node" parent="StateChart/Root"]
script = ExtResource("atomic")

[node name="ToStriking" type="Node" parent="StateChart/Root/Working"]
script = ExtResource("transition")
to = NodePath("../../Striking")
event = &"wage_missed"
delay_in_seconds = "0.0"

[node name="Striking" type="Node" parent="StateChart/Root"]
script = ExtResource("atomic")

[node name="ToWorking" type="Node" parent="StateChart/Root/Striking"]
script = ExtResource("transition")
to = NodePath("../../Working")
event = &"wage_paid"
delay_in_seconds = "0.0"

[connection signal="state_entered" from="StateChart/Root/Absent" to="." method="_on_absent_state_entered"]
[connection signal="state_entered" from="StateChart/Root/Working" to="." method="_on_working_state_entered"]
[connection signal="state_processing" from="StateChart/Root/Working" to="." method="_on_working_state_processing"]
[connection signal="state_entered" from="StateChart/Root/Striking" to="." method="_on_striking_state_entered"]
