[node name="ToTalking" type="Node" parent="StateChart/Root/Walking"]
script = ExtResource("transition")
to = NodePath("../../Talking")
event = &"talk"
delay_in_seconds = "0.0"

[node name="Pausing" type="Node" parent="StateChart/Root"]
