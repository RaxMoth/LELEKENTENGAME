[gd_resource type="Resource" script_class="TowerCatalog" format=3]

[ext_resource type="Script" path="res://Scripts/Resources/tower_catalog.gd" id="catalog"]
[ext_resource type="Script" path="res://Scripts/Resources/tower_data.gd" id="tower"]
[ext_resource type="Resource" path="res://Ressources/Towers/sentry.tres" id="sentry"]
[ext_resource type="Resource" path="res://Ressources/Towers/shock.tres" id="shock"]
[ext_resource type="Resource" path="res://Ressources/Towers/mortar.tres" id="mortar"]
[ext_resource type="Resource" path="res://Ressources/Towers/heat_lance.tres" id="heat_lance"]

[resource]
script = ExtResource("catalog")
towers = Array[ExtResource("tower")]([ExtResource("sentry"), ExtResource("shock"), ExtResource("mortar"), ExtResource("heat_lance")])
