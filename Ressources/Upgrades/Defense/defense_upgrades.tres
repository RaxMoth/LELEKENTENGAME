[gd_resource type="Resource" script_class="UpgradeCatalog" format=3]

[ext_resource type="Script" path="res://Scripts/Resources/upgrade_catalog.gd" id="catalog"]
[ext_resource type="Script" path="res://Scripts/Resources/upgrade_data.gd" id="upgrade"]
[ext_resource type="Resource" path="res://Ressources/Upgrades/Defense/def_door.tres" id="def_door"]
[ext_resource type="Resource" path="res://Ressources/Upgrades/Defense/def_blaster.tres" id="def_blaster"]
[ext_resource type="Resource" path="res://Ressources/Upgrades/Defense/def_turrets.tres" id="def_turrets"]
[ext_resource type="Resource" path="res://Ressources/Upgrades/Defense/def_security_pc.tres" id="def_security_pc"]
[ext_resource type="Resource" path="res://Ressources/Upgrades/Defense/work_guard.tres" id="work_guard"]
[ext_resource type="Resource" path="res://Ressources/Upgrades/Defense/def_monitor_wall.tres" id="def_monitor_wall"]

[resource]
script = ExtResource("catalog")
area_name = "Defense"
upgrades = Array[ExtResource("upgrade")]([ExtResource("def_door"), ExtResource("def_blaster"), ExtResource("def_turrets"), ExtResource("def_security_pc"), ExtResource("def_monitor_wall"), ExtResource("work_guard")])
