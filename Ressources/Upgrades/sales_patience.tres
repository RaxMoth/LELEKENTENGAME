[gd_resource type="Resource" script_class="UpgradeData" format=3]

[ext_resource type="Script" path="res://Scripts/Resources/upgrade_data.gd" id="script"]

[resource]
script = ExtResource("script")
id = &"sales_patience"
title = "Waiting Bench"
description = "Customers wait 20% longer."
