[sub_resource type="Resource" id="line_0"]
script = ExtResource("line_script")
category = &"greet"
text = "Ey Digga, was geht?"
stream = ExtResource("stream_0")

[sub_resource type="Resource" id="line_1"]
script = ExtResource("line_script")
category = &"greet"
text = "Moin Meister, läuft bei dir?"
stream = ExtResource("stream_1")

[sub_resource type="Resource" id="line_2"]
script = ExtResource("line_script")
category = &"greet"
text = "Servus! Dein Lieblingskunde ist wieder da."
stream = ExtResource("stream_2")

[sub_resource type="Resource" id="line_3"]
script = ExtResource("line_script")
category = &"greet"
text = "Na, alles fit im Schritt?"
stream = ExtResource("stream_3")

[sub_resource type="Resource" id="line_4"]
script = ExtResource("line_script")
category = &"greet"
text = "Hey Leute, und herzlich willkommen zu meinem Einkauf!"
stream = ExtResource("stream_4")

[sub_resource type="Resource" id="line_5"]
script = ExtResource("line_script")
category = &"order"
text = "Gib mal was Feines, aber keine Lauch-Qualität."
stream = ExtResource("stream_5")

[sub_resource type="Resource" id="line_6"]
script = ExtResource("line_script")
category = &"order"
text = "Ich nehm das Übliche, ich hab heut noch was vor."
stream = ExtResource("stream_6")

[sub_resource type="Resource" id="line_7"]
script = ExtResource("line_script")
category = &"order"
text = "Was ist das für 1 Angebot heute? Zeig mal."
stream = ExtResource("stream_7")

[sub_resource type="Resource" id="line_8"]
script = ExtResource("line_script")
category = &"happy"
text = "Ehrenmann! Wirklich."
stream = ExtResource("stream_8")

[sub_resource type="Resource" id="line_9"]
script = ExtResource("line_script")
category = &"happy"
text = "Läuft bei dir, Digga!"
stream = ExtResource("stream_9")

[sub_resource type="Resource" id="line_10"]
script = ExtResource("line_script")
category = &"happy"
text = "Gönn dir! Ich komm wieder."
stream = ExtResource("stream_10")

[sub_resource type="Resource" id="line_11"]
script = ExtResource("line_script")
category = &"happy"
text = "Sheesh, das ist ja Premium."
stream = ExtResource("stream_11")

[sub_resource type="Resource" id="line_12"]
script = ExtResource("line_script")
category = &"happy"
text = "Das kommt sofort in meine Story! Link in Bio!"
stream = ExtResource("stream_12")

[sub_resource type="Resource" id="line_13"]
script = ExtResource("line_script")
category = &"angry"
text = "Bist du komplett lost? So teuer?"
stream = ExtResource("stream_13")

[sub_resource type="Resource" id="line_14"]
script = ExtResource("line_script")
category = &"angry"
text = "Digga, das ist Wucher. Ehrenlos."
stream = ExtResource("stream_14")

[sub_resource type="Resource" id="line_15"]
script = ExtResource("line_script")
category = &"angry"
text = "Alter, ich bin doch kein Goldesel."
stream = ExtResource("stream_15")

[sub_resource type="Resource" id="line_16"]
script = ExtResource("line_script")
category = &"angry"
text = "Für den Preis? Nee, da bin ich raus."
stream = ExtResource("stream_16")

[sub_resource type="Resource" id="line_17"]
script = ExtResource("line_script")
category = &"impatient"
text = "Digga, ich wart hier schon ewig."
stream = ExtResource("stream_17")

[sub_resource type="Resource" id="line_18"]
script = ExtResource("line_script")
category = &"impatient"
text = "Wird das heute noch was?"
stream = ExtResource("stream_18")

[sub_resource type="Resource" id="line_19"]
script = ExtResource("line_script")
category = &"impatient"
text = "Bruder, mein Döner wird kalt."
stream = ExtResource("stream_19")

[sub_resource type="Resource" id="line_20"]
script = ExtResource("line_script")
category = &"sent_away"
text = "Wie, du schickst mich weg? Krass."
stream = ExtResource("stream_20")

[sub_resource type="Resource" id="line_21"]
script = ExtResource("line_script")
category = &"sent_away"
text = "Okay, dann eben nicht, du Lappen."
stream = ExtResource("stream_21")

[sub_resource type="Resource" id="line_22"]
script = ExtResource("line_script")
category = &"sent_away"
text = "Wow. Hätte ich nicht von dir gedacht."
stream = ExtResource("stream_22")

[sub_resource type="Resource" id="line_23"]
script = ExtResource("line_script")
category = &"hello"
text = "Was guckst du? Bin ich Kino?"
stream = ExtResource("stream_23")

[sub_resource type="Resource" id="line_24"]
script = ExtResource("line_script")
category = &"hello"
text = "Moin. Wetter heute, ne?"
stream = ExtResource("stream_24")

[sub_resource type="Resource" id="line_25"]
script = ExtResource("line_script")
category = &"hello"
text = "Hallo? Kennen wir uns?"
stream = ExtResource("stream_25")

[sub_resource type="Resource" id="line_26"]
script = ExtResource("line_script")
category = &"hello"
text = "Ja bitte, was gibt's?"
stream = ExtResource("stream_26")

[sub_resource type="Resource" id="line_27"]
script = ExtResource("line_script")
category = &"smalltalk"
text = "Der Bus kommt schon wieder nicht."
stream = ExtResource("stream_27")

[sub_resource type="Resource" id="line_28"]
script = ExtResource("line_script")
category = &"smalltalk"
text = "Mein WLAN ist weg. Das Internet ist für uns alle Neuland."
stream = ExtResource("stream_28")

[sub_resource type="Resource" id="line_29"]
script = ExtResource("line_script")
category = &"smalltalk"
text = "Ich hab Rücken. Schon seit Jahren."
stream = ExtResource("stream_29")

[sub_resource type="Resource" id="line_30"]
script = ExtResource("line_script")
category = &"smalltalk"
text = "Heute ist so ein Tag, wo nichts klappt. Wie jeden Tag."
stream = ExtResource("stream_30")

[sub_resource type="Resource" id="line_31"]
script = ExtResource("line_script")
category = &"smalltalk"
text = "Wer das hört, ist doof."
stream = ExtResource("stream_31")

[sub_resource type="Resource" id="line_32"]
script = ExtResource("line_script")
category = &"smalltalk"
text = "Wie geil ist das denn bitte, die Sonne scheint!"
stream = ExtResource("stream_32")

[sub_resource type="Resource" id="line_33"]
script = ExtResource("line_script")
category = &"pitch_yes"
text = "Hm. Warum eigentlich nicht? Ich komm nachher vorbei."
stream = ExtResource("stream_33")

[sub_resource type="Resource" id="line_34"]
script = ExtResource("line_script")
category = &"pitch_yes"
text = "Psst, nicht so laut! Ja, ich komm zum Fenster."
stream = ExtResource("stream_34")

[sub_resource type="Resource" id="line_35"]
script = ExtResource("line_script")
category = &"pitch_yes"
text = "Sag das doch gleich, Digga. Bin unterwegs."
stream = ExtResource("stream_35")

[sub_resource type="Resource" id="line_36"]
script = ExtResource("line_script")
category = &"pitch_no"
text = "Nee, ich bin clean. Seit gestern."
stream = ExtResource("stream_36")

[sub_resource type="Resource" id="line_37"]
script = ExtResource("line_script")
category = &"pitch_no"
text = "Junge, ich ruf gleich die Polizei. Spaß. Aber nee."
stream = ExtResource("stream_37")

[sub_resource type="Resource" id="line_38"]
script = ExtResource("line_script")
category = &"pitch_no"
text = "Ich hab nur Kleingeld für den Bus."
stream = ExtResource("stream_38")

[sub_resource type="Resource" id="line_39"]
script = ExtResource("line_script")
category = &"bye"
text = "Ciao Kakao!"
stream = ExtResource("stream_39")

[sub_resource type="Resource" id="line_40"]
script = ExtResource("line_script")
category = &"bye"
text = "Tschüssikowski!"
stream = ExtResource("stream_40")

[sub_resource type="Resource" id="line_41"]
script = ExtResource("line_script")
category = &"bye"
text = "Hau rein!"
stream = ExtResource("stream_41")

[sub_resource type="Resource" id="line_42"]
script = ExtResource("line_script")
category = &"bye"
text = "Bis später, Attentäter!"
stream = ExtResource("stream_42")

[sub_resource type="Resource" id="line_43"]
script = ExtResource("line_script")
category = &"ambient"
text = "Alter, ist das hier eine Gegend."
stream = ExtResource("stream_43")

[sub_resource type="Resource" id="line_44"]
script = ExtResource("line_script")
category = &"ambient"
text = "Wo hab ich nur mein Handy hingelegt?"
stream = ExtResource("stream_44")

[sub_resource type="Resource" id="line_45"]
script = ExtResource("line_script")
category = &"ambient"
text = "Ich brauch erstmal einen Kaffee."
stream = ExtResource("stream_45")

[sub_resource type="Resource" id="line_46"]
script = ExtResource("line_script")
category = &"ambient"
text = "Was ein Montag. Obwohl Dienstag ist."
stream = ExtResource("stream_46")

[sub_resource type="Resource" id="line_47"]
script = ExtResource("line_script")
category = &"ambient"
text = "Hat jemand meinen Hund gesehen?"
stream = ExtResource("stream_47")

