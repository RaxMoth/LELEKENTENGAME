daily_rewards = Array[ExtResource("3_kxyoi")]([SubResource("Resource_day1"), SubResource("Resource_day2"), SubResource("Resource_day3"), SubResource("Resource_day4"), SubResource("Resource_day5"), SubResource("Resource_day6"), SubResource("Resource_day7")])
