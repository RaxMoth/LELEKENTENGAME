[resource]
script = ExtResource("11_hlth3")
game_title = "Porchlight VR"
currencies = Array[ExtResource("2_uypxx")]([SubResource("Resource_cash")])
upgrade_catalogs = Array[ExtResource("12_catalog")]([ExtResource("catalog_lab"), ExtResource("catalog_sales"), ExtResource("catalog_defense"), ExtResource("catalog_house")])
